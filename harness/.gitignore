# Laufzeitdaten des Harness: keine Belege, keine Secrets -> nicht ins Repo.
# (Die Profile in profiles/ SIND Ergebnis einer Handpruefung und bleiben getrackt.)
state/
logs/
runs/
snapshots/
preview/
inbox/
outbox/
sessions/
cc-worker/
cc-reviewer/
# Eigener Konfigordner der DeepSeek-Aussensicht (angelegt von
# tools/effort_probe.py, spaeter gebraucht vom Umschalter). Laufzeitdaten,
# keine Belege - genau wie die zwei Nachbarn oben.
cc-aussensicht/
__pycache__/
*.pyc
*.log
*.jsonl
!tests/**

# Diese beiden Muster stehen NACH der Test-Ausnahme: ohne sie waeren
# tests/__pycache__/*.pyc wieder dabei ("!tests/**" hebt sonst alles auf).
__pycache__/
*.pyc

# Ebenso: die Temp-Ordner der Testlaeufe (tests/_tmp_r13b, _tmp_r13d, ...).
# Auch sie muss die Ausnahme ausdruecklich zuruecknehmen - der Wurzel-Eintrag
# `harness/tests/_tmp_*/` greift hier NICHT mehr, weil diese Datei tiefer liegt.
# Aufgefallen am 2026-09-26: ein abgebrochener Testlauf liess
# tests/_tmp_r13d/repo/ liegen - ein eingebettetes Git-Repo im Arbeitsbaum.
tests/_tmp_*/
