# --- Build-Ausgaben -------------------------------------------------------
build/
out/
bin/
obj/
dist/

# Objekt- und Binaerdateien (Harness-Ziele bleiben im Repo: Makefile, Skripte)
*.o
*.obj
*.exe
*.dll
*.so
*.a
*.lib
*.pdb
*.ilk
*.exp

# --- CMake -----------------------------------------------------------------
CMakeCache.txt
CMakeFiles/
cmake_install.cmake

# --- VS Code (Workspace-Datei wird getrackt, lokale Settings nicht) --------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# --- Laufprotokolle / temporaere Dateien -----------------------------------
*.log
*.tmp
*.bak
*.ppm

# --- Secrets (niemals versionieren) ---------------------------------------
# Enthaelt z. B. secrets/deepseek.key (API-Key fuer den Sandbox-Test B-prime).
secrets/

# --- Sandkasten (niemals versionieren) ------------------------------------
# Enthaelt die Junction sandbox/decomp-link -> g:\Silent Scope Decomp, rohe
# Mitschnitte mit vollstaendigen Prompts (_probe_stream.jsonl, _b2_*.stdout.txt),
# eigene Claude-Konfigurationen (cc-worker-config, _b2_otel) und die
# Worker-Arbeitskopie (workspace/).
sandbox/

# --- Harness-Laufzeitdaten (keine Belege, kein Zustand, keine Mitschnitte) --
# Der Quellcode (hx/, tests/, profiles/, prompts/, *.ps1) bleibt getrackt.
harness/runs/
harness/logs/
harness/state/
harness/inbox/
harness/outbox/
harness/preview/
harness/snapshots/
harness/sessions/
# CLAUDE_CONFIG_DIR von Worker und Reviewer: enthaelt Sitzungsverlauf.
harness/cc-worker/
harness/cc-reviewer/
# Tempoerder der Testlaeufe (tests/_tmp_r13b, _tmp_r13c, _tmp_r13d, ...)
harness/tests/_tmp_*/

# --- Ghidra-Projektsicherungen (gross, jederzeit neu erzeugbar) -----------
backups/

# --- Python ---------------------------------------------------------------
__pycache__/
*.pyc
